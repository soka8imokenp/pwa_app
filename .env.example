# Daily Sumire - Client Environment Configuration

# Server API URL (Defaults to current host /api or localhost:3001)
VITE_API_BASE_URL=http://localhost:3001/api

# Google Gemini AI API Key for Sumire Assistant & Nutrition Vision
# (Users can also set this directly inside the app in Settings)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# App Environment (development | production)
VITE_APP_ENV=development
