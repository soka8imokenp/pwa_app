{
  "appId": "com.kairo.planner",
  "appName": "Daily Sumire",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "open.spotify.com",
      "accounts.spotify.com",
      "*.spotify.com",
      "*.scdn.co",
      "*.spotifycdn.com",
      "github.com",
      "*.github.com",
      "*.githubusercontent.com"
    ]
  },
  "android": {
    "backgroundColor": "#F4F0EA",
    "allowMixedContent": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
