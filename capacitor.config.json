{
  "appId": "com.kairo.planner",
  "appName": "Daily Sumire",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "localhost",
      "*.localhost",
      "https://localhost",
      "https://localhost/*",
      "accounts.google.com",
      "*.google.com",
      "*.googleusercontent.com",
      "open.spotify.com",
      "accounts.spotify.com",
      "*.spotify.com",
      "*.scdn.co",
      "*.spotifycdn.com",
      "github.com",
      "*.github.com",
      "*.githubusercontent.com",
      "*.youtube.com",
      "*.youtube-nocookie.com",
      "*.googlevideo.com",
      "*.ytimg.com"
    ]
  },
  "android": {
    "backgroundColor": "#F4F0EA",
    "allowMixedContent": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "launchFadeOutDuration": 150,
      "backgroundColor": "#F4F0EA",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
