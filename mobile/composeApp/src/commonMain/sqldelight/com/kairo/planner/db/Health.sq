CREATE TABLE health_profile (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL DEFAULT '',
    birth_year INTEGER NOT NULL DEFAULT 0,
    age INTEGER NOT NULL DEFAULT 0,
    gender TEXT NOT NULL DEFAULT 'male',
    height_cm REAL NOT NULL DEFAULT 0,
    current_weight REAL NOT NULL DEFAULT 0,
    target_weight REAL NOT NULL DEFAULT 0,
    waist_cm REAL NOT NULL DEFAULT 0,
    activity_level TEXT NOT NULL DEFAULT 'moderate',
    goal TEXT NOT NULL DEFAULT 'maintain',
    step_goal INTEGER NOT NULL DEFAULT 10000,
    water_goal_ml INTEGER NOT NULL DEFAULT 0,
    calorie_goal_override INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL
);

CREATE TABLE weight_log (
    id TEXT NOT NULL PRIMARY KEY,
    date TEXT NOT NULL,
    measured_at INTEGER NOT NULL,
    weight REAL NOT NULL,
    bmi REAL NOT NULL,
    body_fat REAL,
    waist_cm REAL,
    impedance INTEGER,
    note TEXT NOT NULL DEFAULT '',
    source TEXT NOT NULL DEFAULT 'manual',
    metrics_json TEXT,
    external_id TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX weight_date ON weight_log(date);
CREATE UNIQUE INDEX weight_external ON weight_log(external_id);

CREATE TABLE meal_log (
    id TEXT NOT NULL PRIMARY KEY,
    date TEXT NOT NULL,
    time TEXT NOT NULL DEFAULT '',
    name TEXT NOT NULL,
    meal_type TEXT NOT NULL,
    kcal INTEGER NOT NULL,
    protein REAL NOT NULL DEFAULT 0,
    carbs REAL NOT NULL DEFAULT 0,
    fat REAL NOT NULL DEFAULT 0,
    grams INTEGER,
    ai_estimated INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX meal_date ON meal_log(date);

CREATE TABLE water_log (
    id TEXT NOT NULL PRIMARY KEY,
    date TEXT NOT NULL,
    amount_ml INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX water_date ON water_log(date);

CREATE TABLE workout_log (
    id TEXT NOT NULL PRIMARY KEY,
    date TEXT NOT NULL,
    title TEXT NOT NULL,
    category TEXT NOT NULL,
    duration_minutes INTEGER NOT NULL,
    calories INTEGER NOT NULL DEFAULT 0,
    notes TEXT NOT NULL DEFAULT '',
    source TEXT NOT NULL DEFAULT 'manual',
    external_id TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX workout_date ON workout_log(date);
CREATE UNIQUE INDEX workout_external ON workout_log(external_id);

CREATE TABLE step_log (
    date TEXT NOT NULL PRIMARY KEY,
    steps INTEGER NOT NULL,
    goal INTEGER NOT NULL,
    calories INTEGER NOT NULL,
    distance_m INTEGER NOT NULL,
    active_minutes INTEGER NOT NULL,
    source TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

selectProfile:
SELECT * FROM health_profile WHERE id = 'user';

upsertProfile:
INSERT OR REPLACE INTO health_profile VALUES ?;

selectWeightsBetween:
SELECT * FROM weight_log WHERE deleted_at IS NULL AND date BETWEEN ? AND ? ORDER BY measured_at;

selectAllWeights:
SELECT * FROM weight_log WHERE deleted_at IS NULL ORDER BY measured_at;

selectLatestWeight:
SELECT * FROM weight_log WHERE deleted_at IS NULL ORDER BY measured_at DESC LIMIT 1;

selectWeightsChangedSince:
SELECT * FROM weight_log WHERE updated_at > ?;

selectWeightByExternal:
SELECT * FROM weight_log WHERE external_id = ?;

upsertWeight:
INSERT OR REPLACE INTO weight_log VALUES ?;

softDeleteWeight:
UPDATE weight_log SET deleted_at = :now, updated_at = :now WHERE id = :id;

selectMealsForDate:
SELECT * FROM meal_log WHERE deleted_at IS NULL AND date = ? ORDER BY time, created_at;

selectMealsBetween:
SELECT * FROM meal_log WHERE deleted_at IS NULL AND date BETWEEN ? AND ? ORDER BY date, time;

selectMealsChangedSince:
SELECT * FROM meal_log WHERE updated_at > ?;

recentMealNames:
SELECT name, meal_type, kcal, protein, carbs, fat, grams, MAX(created_at) AS last_used, COUNT(*) AS uses
FROM meal_log WHERE deleted_at IS NULL GROUP BY lower(name) ORDER BY uses DESC, last_used DESC LIMIT 12;

upsertMeal:
INSERT OR REPLACE INTO meal_log VALUES ?;

softDeleteMeal:
UPDATE meal_log SET deleted_at = :now, updated_at = :now WHERE id = :id;

selectWaterForDate:
SELECT * FROM water_log WHERE deleted_at IS NULL AND date = ? ORDER BY created_at;

selectWaterBetween:
SELECT date, SUM(amount_ml) AS total FROM water_log WHERE deleted_at IS NULL AND date BETWEEN ? AND ? GROUP BY date;

selectWaterChangedSince:
SELECT * FROM water_log WHERE updated_at > ?;

upsertWater:
INSERT OR REPLACE INTO water_log VALUES ?;

softDeleteWater:
UPDATE water_log SET deleted_at = :now, updated_at = :now WHERE id = :id;

selectWorkoutsBetween:
SELECT * FROM workout_log WHERE deleted_at IS NULL AND date BETWEEN ? AND ? ORDER BY date DESC, created_at DESC;

selectWorkoutsChangedSince:
SELECT * FROM workout_log WHERE updated_at > ?;

selectWorkoutByExternal:
SELECT * FROM workout_log WHERE external_id = ?;

upsertWorkout:
INSERT OR REPLACE INTO workout_log VALUES ?;

softDeleteWorkout:
UPDATE workout_log SET deleted_at = :now, updated_at = :now WHERE id = :id;

selectStepsBetween:
SELECT * FROM step_log WHERE date BETWEEN ? AND ? ORDER BY date;

selectStepsForDate:
SELECT * FROM step_log WHERE date = ?;

selectStepsChangedSince:
SELECT * FROM step_log WHERE updated_at > ?;

upsertSteps:
INSERT OR REPLACE INTO step_log VALUES ?;
