CREATE TABLE task (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    notes TEXT NOT NULL DEFAULT '',
    is_priority INTEGER NOT NULL DEFAULT 0,
    is_completed INTEGER NOT NULL DEFAULT 0,
    date TEXT NOT NULL,
    category TEXT NOT NULL DEFAULT 'general',
    estimated_minutes INTEGER NOT NULL DEFAULT 30,
    subtasks_json TEXT NOT NULL DEFAULT '[]',
    recurring_days TEXT NOT NULL DEFAULT '',
    sort_order INTEGER NOT NULL DEFAULT 0,
    reminder_at INTEGER,
    completed_at INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX task_date ON task(date);
CREATE INDEX task_updated ON task(updated_at);

selectForDate:
SELECT * FROM task WHERE date = ? AND deleted_at IS NULL ORDER BY is_completed, sort_order, created_at;

selectBetween:
SELECT * FROM task WHERE date BETWEEN ? AND ? AND deleted_at IS NULL ORDER BY date, sort_order;

selectBacklog:
SELECT * FROM task WHERE is_priority = 0 AND is_completed = 0 AND deleted_at IS NULL ORDER BY date DESC, sort_order;

selectOpenBefore:
SELECT * FROM task WHERE date < ? AND is_completed = 0 AND deleted_at IS NULL;

selectRecurringTemplates:
SELECT * FROM task WHERE recurring_days != '' AND deleted_at IS NULL;

selectById:
SELECT * FROM task WHERE id = ?;

selectAll:
SELECT * FROM task;

selectCompleted:
SELECT date FROM task WHERE is_completed = 1 AND deleted_at IS NULL;

selectChangedSince:
SELECT * FROM task WHERE updated_at > ?;

search:
SELECT * FROM task WHERE deleted_at IS NULL AND title LIKE '%' || ? || '%' ORDER BY date DESC LIMIT 20;

upsert:
INSERT OR REPLACE INTO task(id, title, notes, is_priority, is_completed, date, category, estimated_minutes, subtasks_json, recurring_days, sort_order, reminder_at, completed_at, created_at, updated_at, deleted_at)
VALUES ?;

softDelete:
UPDATE task SET deleted_at = :now, updated_at = :now WHERE id = :id;

purgeDeletedBefore:
DELETE FROM task WHERE deleted_at IS NOT NULL AND deleted_at < ?;
