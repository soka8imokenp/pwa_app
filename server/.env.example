# Daily Sumire Sync Server - Environment Configuration

# Server Port
PORT=3001

# Node Environment (development | production | test)
NODE_ENV=development

# Database Connection (SQLite default, can be PostgreSQL in cloud)
DATABASE_URL="file:./dev.db"

# JWT secrets – REQUIRED in production (server refuses to start without them).
# Generate each with: openssl rand -hex 48   (they must differ)
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Allowed CORS Origins (comma-separated, or * for open during dev)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,capacitor://localhost,https://localhost"

# Web Push Notifications (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@dailysumire.app"

# Google OAuth client IDs whose tokens are accepted (comma-separated: web, Android, iOS).
# Required for "Continue with Google" – tokens issued to any other app are rejected.
GOOGLE_CLIENT_IDS="your_web_client_id.apps.googleusercontent.com"

