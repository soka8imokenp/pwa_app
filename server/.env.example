# Daily Sumire Sync Server - Environment Configuration

# Server Port
PORT=3001

# Node Environment (development | production | test)
NODE_ENV=development

# Database Connection (SQLite default, can be PostgreSQL in cloud)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets (Must be changed in production!)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_chars"
JWT_REFRESH_SECRET="replace_with_a_secure_random_refresh_secret_min_32_chars"

# Allowed CORS Origins (comma-separated, or * for open during dev)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,capacitor://localhost,https://localhost"

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:support@dailysumire.app"

# Google OAuth Client ID (Optional server validation)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"

